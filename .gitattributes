# 統一行尾：所有文字檔一律以 LF 存進 repo，避免 CRLF/LF noise。
# commit 時自動把 CRLF 正規化成 LF；checkout 時也輸出 LF。
* text=auto eol=lf

# Windows 批次檔必須保留 CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二進位檔不做任何行尾轉換
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.jar   binary
*.aar   binary
*.apk   binary
*.aab   binary
*.zip   binary
*.so    binary
*.keystore binary
*.jks   binary
*.ttf   binary
*.otf   binary
*.woff  binary
*.woff2 binary
